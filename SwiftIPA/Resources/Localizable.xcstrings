    "Support": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        }
      }
    },
    "There isn't enough room in the tweak to point it at %@. Rename the substrate dylib in the Tweak Library to something shorter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Tweak ist nicht genug Platz, um ihn auf %@ zu verweisen. Benenne die Substrate-dylib in der Tweak-Bibliothek kürzer um."
          }
        }
      }
    },
    "This .deb uses %@ compression, which SwiftIPA can't unpack yet. Re-export it as a raw .dylib instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese .deb nutzt %@-Komprimierung, die SwiftIPA noch nicht entpacken kann. Exportiere sie stattdessen als .dylib."
          }
        }
      }
    },
    "This certificate is a wildcard, so the original bundle ID is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Zertifikat ist ein Wildcard-Zertifikat, daher bleibt die ursprüngliche Bundle-ID erhalten."
          }
        }
      }
    },
    "Tweaks from a .deb that hook with CydiaSubstrate need ElleKit. Import ElleKit's .deb once and SwiftIPA injects it automatically whenever a tweak needs it. Long-press a tweak for more options.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaks aus einer .deb, die mit CydiaSubstrate hooken, brauchen ElleKit. Importiere die .deb von ElleKit einmal und SwiftIPA injiziert es automatisch, wann immer ein Tweak es braucht. Halte einen Tweak gedrückt für mehr Optionen."
          }
        }
      }
    },
    "Tweaks from a .deb usually need ElleKit. Add ElleKit's .deb here too and it gets injected automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaks aus einer .deb brauchen meist ElleKit. Füge hier auch die .deb von ElleKit hinzu, dann wird es automatisch injiziert."
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Art"
          }
        }
      }
    },
    "Use Bundle ID from Certificate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle-ID vom Zertifikat verwenden"
          }
        }
      }
    },
    "Use as Substrate (ElleKit)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Substrate verwenden (ElleKit)"
          }
        }
      }
    },
    "Uses the bundle ID from the provisioning profile of the certificate you sign with. Wildcard profiles keep the app's own ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Bundle-ID aus dem Provisioning-Profil des Zertifikats, mit dem du signierst. Bei Wildcard-Profilen bleibt die ID der App erhalten."
          }
        }
      }
    },
    "View Open Issues": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Issues ansehen"
          }
        }
      }
    },
    "What happened, and what did you expect?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert und was hast du erwartet?"
          }
        }
      }
    },
    "What would you like SwiftIPA to do?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll SwiftIPA können?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
