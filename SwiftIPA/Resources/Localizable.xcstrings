    "Design forces an app to use, or not use, iOS 26's Liquid Glass redesign. Not every app supports being switched either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design erzwingt, dass eine App das Liquid-Glass-Redesign von iOS 26 verwendet oder nicht verwendet. Nicht jede App unterstützt beide Richtungen."
          }
        }
      }
    },
