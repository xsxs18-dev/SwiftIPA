{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add Certificate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat hinzufügen"
          }
        }
      }
    },
    "Add Source": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle hinzufügen"
          }
        }
      }
    },
    "Add a certificate in Settings first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst in den Einstellungen ein Zertifikat hinzu."
          }
        }
      }
    },
    "Add a certificate in the Certificates tab first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst im Tab „Zertifikate“ ein Zertifikat hinzu."
          }
        }
      }
    },
    "Add an AltStore or ESign-compatible repo URL to browse and sign apps straight from it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine AltStore- oder ESign-kompatible Repo-URL hinzu, um Apps direkt daraus zu laden und zu signieren."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitert"
          }
        }
      }
    },
    "Allow Arbitrary Network Loads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebige Netzwerkverbindungen erlauben"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        }
      }
    },
    "App extensions and plug-ins increase signing time and can fail on some certificates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Erweiterungen und Plug-ins verlängern die Signierzeit und können bei manchen Zertifikaten fehlschlagen."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Append suffix": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suffix anhängen"
          }
        }
      }
    },
    "Applies to every app you sign unless you change it for that sign, or a preset overrides it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jede App, die du signierst, außer du änderst es für diesen einen Vorgang oder ein Preset überschreibt es."
          }
        }
      }
    },
    "Applying modifiers…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifikatoren werden angewendet…"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch"
          }
        }
      }
    },
    "Batch Sign": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel signieren"
          }
        }
      }
    },
    "Before your first direct install, iOS needs to trust SwiftIPA's local certificate. Do this once — every install after is a single tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der ersten Direktinstallation muss iOS SwiftIPAs lokalem Zertifikat vertrauen. Einmal erledigt, ist jede weitere Installation nur noch ein Tap."
          }
        }
      }
    },
    "Brought in \\(imported) app(s) shared from another app.": {
      "localizations": {
        "de": {
          "stringUnit": {
